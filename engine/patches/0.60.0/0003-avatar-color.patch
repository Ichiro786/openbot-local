+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readJson, requireAgentLevel, requireVisibleBodyAgent } from "./request-helpers";
+
+/**
+ * OpenBot Local (`avatar-color-v1`): any member reads the custom avatar colours, and sets one with the
+ * `manage` level that an agent edit needs. An agent that this peer cannot see is not listed and cannot be set.
+ */
+export async function routeAvatarColor(
+  context: TeamApiRequestContext,
+  agents: TeamApiAvatarColors | undefined,
+  hiddenAgentIds: ReadonlySet<string>,
+): Promise<RouteOutcome> {
+  const { method, url, capabilities, request, json } = context;
+  if (method !== "POST" || !Object.values(AVATAR_COLOR_ROUTES).some((path) => path === url.pathname))
+    return "unmatched";
+  if (!agents || !capabilities.has(AVATAR_COLOR_CAPABILITY))
+    throw new HttpError(400, "This server does not support custom avatar colours.");
+  // `readJson` has already run the body through the `avatar-color-v1` codec.
+  const body = await readJson(request);
+  if (url.pathname === AVATAR_COLOR_ROUTES.set) {
+    requireVisibleBodyAgent(body, hiddenAgentIds);
+    let input: ReturnType<typeof parseSetAgentAvatarColorInput>;
+    try {
+      input = parseSetAgentAvatarColorInput(body);
+    } catch {
+      throw new HttpError(400, "An avatar colour request is invalid.");
+    }
+    // The same level as `PATCH /v1/agents/:id`, which changes the preset hue.
+    requireAgentLevel(context, input.agentId, "manage");
+    await runCauseEffect(agents.setAvatarColor(input));
+  }
+  const snapshot = agents.listAvatarColors();
+  return json(200, { agents: snapshot.agents.filter((agent) => !hiddenAgentIds.has(agent.agentId)) });
+}
