diff --git a/src/main/team-api/route-whatsapp.ts b/src/main/team-api/route-whatsapp.ts
new file mode 100644
index 0000000..8f3fc07
--- /dev/null
+++ b/src/main/team-api/route-whatsapp.ts
@@ -0,0 +1,105 @@
+import {
+  WHATSAPP_MOBILE_CAPABILITY,
+  WHATSAPP_MOBILE_ROUTES,
+} from "@openbot/contracts/team-protocol/whatsapp-mobile-v1";
+import { sourceText } from "@openbot/i18n/source";
+import { runCauseEffect } from "../../backend/effect-boundary";
+import {
+  parseAddTelegramOrchestratorInput,
+  parseAnswerWhatsAppRequestInput,
+  parseMessagingWorkspaceInput,
+  parseRemoveWhatsAppSenderInput,
+  parseSetMessagingEnabledInput,
+  parseSetWhatsAppOwnNumberInput,
+  parseStartWhatsAppLinkInput,
+  parseWhatsAppSenderInput,
+} from "../ipc/messaging-inputs";
+import type { TeamApiConnectors } from "./dependencies";
+import { HttpError } from "./http-error";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readJson, requireAdmin } from "./request-helpers";
+
+const ROUTES: ReadonlySet<string> = new Set(Object.values(WHATSAPP_MOBILE_ROUTES));
+
+/** The host's own IPC parsers check each body, so a route accepts exactly what the host's page sends. */
+function parsed<T>(parse: (value: unknown) => T, value: unknown): T {
+  try {
+    return parse(value);
+  } catch {
+    throw new HttpError(400, "A WhatsApp request is invalid.");
+  }
+}
+
+/**
+ * OpenBot Local: the WhatsApp numbers linked to this host, managed from another device of an owner or
+ * admin (`whatsapp-mobile-v1`). Each route runs the same `MessagingService` operation as the host's
+ * own WhatsApp page. `requireAdmin` runs on every route.
+ */
+export async function routeWhatsApp(
+  context: TeamApiRequestContext,
+  connectors: TeamApiConnectors | undefined,
+): Promise<RouteOutcome> {
+  const { method, url, capabilities, member, request, json } = context;
+  if (method !== "POST" || !ROUTES.has(url.pathname)) return "unmatched";
+  if (!connectors || !capabilities.has(WHATSAPP_MOBILE_CAPABILITY))
+    throw new HttpError(400, sourceText("error.team.connectorsUnsupported"));
+  requireAdmin(member);
+  // `readJson` has already run the body through the `whatsapp-mobile-v1` codec.
+  const body = await readJson(request);
+  const { messaging } = connectors;
+  switch (url.pathname) {
+    case WHATSAPP_MOBILE_ROUTES.overview:
+      return json(200, messaging.whatsappOverview());
+    case WHATSAPP_MOBILE_ROUTES.linkStart:
+      return json(200, await runCauseEffect(messaging.startWhatsAppLink(parsed(parseStartWhatsAppLinkInput, body))));
+    case WHATSAPP_MOBILE_ROUTES.linkState:
+      return json(200, messaging.whatsappLinkState());
+    case WHATSAPP_MOBILE_ROUTES.linkCancel:
+      await runCauseEffect(messaging.cancelWhatsAppLink());
+      return json(200, {});
+    case WHATSAPP_MOBILE_ROUTES.disconnect:
+      await runCauseEffect(messaging.disconnectWhatsAppNumber(parsed(parseMessagingWorkspaceInput, body).workspaceId));
+      return json(200, {});
+    case WHATSAPP_MOBILE_ROUTES.reconnect:
+      await runCauseEffect(
+        messaging.reconnect("whatsapp", parsed(parseMessagingWorkspaceInput, body).workspaceId, false),
+      );
+      return json(200, {});
+    case WHATSAPP_MOBILE_ROUTES.enabled: {
+      const { workspaceId, enabled } = parsed(parseSetMessagingEnabledInput, body);
+      await runCauseEffect(messaging.setEnabled("whatsapp", workspaceId, enabled));
+      return json(200, {});
+    }
+    case WHATSAPP_MOBILE_ROUTES.orchestrator:
+      // Absent, the provider and model are a new agent's default, as the host picks it.
+      return json(
+        200,
+        await runCauseEffect(messaging.addWhatsAppOrchestrator(parsed(parseAddTelegramOrchestratorInput, body))),
+      );
+    case WHATSAPP_MOBILE_ROUTES.groups:
+      return json(
+        200,
+        await runCauseEffect(messaging.listWhatsAppGroups(parsed(parseMessagingWorkspaceInput, body).workspaceId)),
+      );
+    case WHATSAPP_MOBILE_ROUTES.senderAdd: {
+      const { workspaceId, sender } = parsed(parseWhatsAppSenderInput, body);
+      await runCauseEffect(messaging.addWhatsAppSender(workspaceId, sender));
+      return json(200, {});
+    }
+    case WHATSAPP_MOBILE_ROUTES.senderRemove: {
+      const { workspaceId, senderId } = parsed(parseRemoveWhatsAppSenderInput, body);
+      await runCauseEffect(messaging.removeWhatsAppSender(workspaceId, senderId));
+      return json(200, {});
+    }
+    case WHATSAPP_MOBILE_ROUTES.requestAnswer: {
+      const { workspaceId, code, approve } = parsed(parseAnswerWhatsAppRequestInput, body);
+      await runCauseEffect(messaging.answerWhatsAppRequest(workspaceId, code, approve));
+      return json(200, {});
+    }
+    default: {
+      const { workspaceId, ownNumber } = parsed(parseSetWhatsAppOwnNumberInput, body);
+      await runCauseEffect(messaging.setWhatsAppOwnNumber(workspaceId, ownNumber));
+      return json(200, {});
+    }
+  }
+}
