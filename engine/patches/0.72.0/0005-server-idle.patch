 import { readdir, rm } from "node:fs/promises";
 import { homedir, hostname, tmpdir } from "node:os";
 import { join, resolve } from "node:path";
@@ -4243,6 +4243,29 @@ export async function createApplicationServices({
       write: (line) => process.stdout.write(line),
     });
   }
+  // OpenBot Local: the Android app keeps the phone awake only while agents work. It watches this
+  // file (inotify on the host side, no polling), so the server writes it only when the count changes.
+  const busyFile = serverModeEnvironment ? process.env.OPENBOT_LOCAL_BUSY_FILE : undefined;
+  if (busyFile) {
+    let lastWorking = -1;
+    const writeBusy = () => {
+      const working = service.workingAgents().length;
+      if (working === lastWorking) return;
+      lastWorking = working;
+      try {
+        writeFileSync(`${busyFile}.tmp`, `working=${working}\n`);
+        renameSync(`${busyFile}.tmp`, busyFile);
+      } catch (error) {
+        logger.warn("Unable to write the OpenBot Local busy file:", toLogValue(error));
+      }
+    };
+    writeBusy();
+    reportLocalServerWorkingAgents({
+      read: () => service.workingAgents(),
+      subscribe: (listener) => service.on("event", listener),
+      write: writeBusy,
+    });
+  }
   configureAttachmentProtocol({ mailbox, agents: service, remoteServers });
   configureServerLogoProtocols({ teamStore, remoteServers });
   // After the servers: the view it opens belongs to one of them, and it has to stop before they do.
