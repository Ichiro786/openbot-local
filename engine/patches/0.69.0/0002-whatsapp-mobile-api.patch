new file mode 100644
index 000000000..6f10ed858
--- /dev/null
+++ b/packages/contracts/src/team-protocol/whatsapp-mobile-v1.ts
@@ -0,0 +1,12 @@
+// OpenBot Local optional whatsapp-mobile-v1 capability (fork patch, not upstream).
+//
+// The OpenBot Local mobile app (engine 0.60.0-2 .. 0.60.0-4) asks for the WhatsApp admin routes with
+// this capability. Upstream then shipped the same 13 routes, paths and bodies as
+// `whatsapp-connector-v1` (#4799), so this is now only an alias: a request that lists either
+// capability reaches `routeWhatsAppConnector`, and the codecs are upstream's. The app sends `{}` to
+// the orchestrator route, which upstream's codec requires.
+import { WHATSAPP_CONNECTOR_ROUTES } from "./whatsapp-connector-v1";
+
+export const WHATSAPP_MOBILE_CAPABILITY = "whatsapp-mobile-v1";
+
+export const WHATSAPP_MOBILE_ROUTES = WHATSAPP_CONNECTOR_ROUTES;
