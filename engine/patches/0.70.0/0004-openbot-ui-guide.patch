+++ b/src/backend/openbot-ui-guide.ts
@@ -0,0 +1,136 @@
+// OpenBot Local (fork patch engine-0.70.0-3): every agent learns the `openbot-ui` blocks that the
+// OpenBot Local Android app renders as native UI (docs/openbot-ui.md in the fork), so nobody has to
+// paste the spec into an agent's instructions. The guide is a decision rule first (when UI beats
+// prose and when it never does), then the shape, and is kept short because it rides in every
+// system prompt.
+//
+// The settings "Rich UI in replies" (on/off) and "Rich UI usage" (low | balanced | high) live in a
+// small JSON file that the app writes inside the rootfs (like dm-context.json):
+//   v2: {"version":2,"enabled":bool,"level":"low"|"balanced"|"high"}
+//   v1: {"version":1,"enabled":bool}            -> level balanced
+// A missing or unreadable file means ON + balanced (the defaults); an unknown level means balanced.
+// It is cached by mtime, so a change applies to the next instructions the engine builds, without a
+// restart.
+import { readFileSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export type OpenbotUiLevel = "low" | "balanced" | "high";
+export const OPENBOT_UI_LEVELS: readonly OpenbotUiLevel[] = ["low", "balanced", "high"];
+
+const HEAD =
+  "The user's OpenBot app renders a fenced ```openbot-ui block (JSON: one node, or one node per line) as native UI; other clients show the JSON. Prose is the default.";
+
+// When to use a block. One rule per level; the never-list below holds at every level.
+const WHEN: Record<OpenbotUiLevel, string> = {
+  low: "Use a block only when the user asks for a chart, table, buttons, choices or a form, or when prose would be overwhelming (4+ options on 3+ attributes, or 8+ numbers). Otherwise answer in prose or Markdown.",
+  balanced: [
+    "Use a block only when one trigger holds, else prose:",
+    "- 2+ options compared on 2+ attributes: table (stats for up to 4 headline numbers)",
+    "- a real numeric series, 3+ points over time or categories: chart",
+    "- the user must pick one of 2-6 known options: actions chips",
+    "- you need 2+ fields from the user: form",
+    "- multi-step work with status: steps or progress",
+    "- a warning they must not miss: callout",
+  ].join("\n"),
+  high: [
+    "Prefer a block wherever structure helps the user, with low thresholds:",
+    "- any comparison of 2+ options: table or stats",
+    "- any set of 3+ real numbers: stats or chart",
+    "- any choice the user must make: actions chips",
+    "- any field to collect: form",
+    "- any multi-step task: steps or progress; any risk: callout",
+    "Still prose when no trigger holds. Never add UI just to decorate.",
+  ].join("\n"),
+};
+
+const NEVER =
+  "Never a block for: chit-chat or greetings, a single fact or short answer, emotional or personal talk, code (use a code block), explanations or reasoning, data you do not have (never invent, estimate or pad numbers; ask or say so), or a follow-up the UI above already answers.";
+
+const RULES =
+  "Always a one-line prose answer outside the block that reads fine alone; at most two blocks. Approvals of sends, deletes and payments still go through openbot.ask_ui.";
+
+const EXAMPLES = [
+  "Examples:",
+  '- "Compare these 3 phones on price, battery, weight" -> one line + table. Good.',
+  '- "thanks!" or "what is the capital of France?" -> a card. Bad: answer in one sentence.',
+  '- "chart my spending" with no figures given -> a chart of guesses. Bad: ask for the data.',
+].join("\n");
+
+const CATALOG =
+  'Nodes ("type"): card {title,subtitle?,body? markdown,image? https,children?: nodes}; stats {items:[{label,value,delta?,tone?:positive|negative|neutral}]}; table {columns:[..],rows:[[..]]}; chart {kind:bar|line|donut,labels:[..],series:[{name,values:[numbers]}]}; list {items:[{icon?,title,subtitle?,trailing?}]}; actions {style?:buttons|chips,items:[{id,label,value?}]}; form {id,fields:[{name,label,kind:text|number|select|toggle,options?,required?}],submit?}; steps {items:[{label,status:done|active|pending|failed}]}; progress {value 0..1,label?}; callout {tone:info|success|warning|error,title?,body}. Max 8 columns, 50 rows, 60 nodes, nesting 3.';
+
+const REPLY =
+  'A tap or form submit comes back as a user message "[ui:action] {"id":…,"value":…} — label": the user\'s answer to that UI. Continue the work; do not show the same UI again unless asked.';
+
+/** The guide for one usage level. */
+export function openbotUiGuide(level: OpenbotUiLevel): string {
+  return ["<openbot_ui>", HEAD, WHEN[level], NEVER, RULES, EXAMPLES, CATALOG, REPLY, "</openbot_ui>"].join("\n");
+}
+
+/** The default (balanced) guide. */
+export const OPENBOT_UI_GUIDE = openbotUiGuide("balanced");
+
+export interface OpenbotUiSetting {
+  enabled: boolean;
+  level: OpenbotUiLevel;
+}
+
+const DEFAULT_SETTING: OpenbotUiSetting = { enabled: true, level: "balanced" };
+
+function settingFile(): string {
+  return process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE || join(homedir(), ".openbot-local", "openbot-ui.json");
+}
+
+function isLevel(value: unknown): value is OpenbotUiLevel {
+  return value === "low" || value === "balanced" || value === "high";
+}
+
+/** Parse the app's setting file text (v1 or v2). Anything unreadable falls back to the defaults. */
+export function parseOpenbotUiSetting(text: string): OpenbotUiSetting {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    return DEFAULT_SETTING;
+  }
+  if (typeof parsed !== "object" || parsed === null) return DEFAULT_SETTING;
+  const enabled = !("enabled" in parsed && parsed.enabled === false);
+  // v1 files have no level: balanced, the behaviour the v1 toggle had.
+  const level = "level" in parsed && isLevel(parsed.level) ? parsed.level : "balanced";
+  return { enabled, level };
+}
+
+let cached: { path: string; mtimeMs: number; setting: OpenbotUiSetting } | null = null;
+
+/** "Rich UI in replies" and "Rich UI usage". Default ON + balanced. */
+export function openbotUiSetting(): OpenbotUiSetting {
+  const path = settingFile();
+  let mtimeMs: number;
+  try {
+    mtimeMs = statSync(path).mtimeMs;
+  } catch {
+    cached = null;
+    return DEFAULT_SETTING;
+  }
+  if (cached && cached.path === path && cached.mtimeMs === mtimeMs) return cached.setting;
+  let setting = DEFAULT_SETTING;
+  try {
+    setting = parseOpenbotUiSetting(readFileSync(path, "utf8"));
+  } catch {
+    setting = DEFAULT_SETTING;
+  }
+  cached = { path, mtimeMs, setting };
+  return setting;
+}
+
+/** Whether "Rich UI in replies" is on. Default ON. */
+export function openbotUiEnabled(): boolean {
+  return openbotUiSetting().enabled;
+}
+
+/** The guide for the chosen level as an instructions section, or nothing when the setting is off. */
+export function openbotUiInstructions(): string[] {
+  const setting = openbotUiSetting();
+  return setting.enabled ? [openbotUiGuide(setting.level)] : [];
+}
