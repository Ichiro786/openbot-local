--- /dev/null
+++ b/src/backend/openbot-ui-guide.test.ts
@@ -0,0 +1,135 @@
+import { mkdtempSync, rmSync, utimesSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type AgentSummary, DEFAULT_AGENT_DEFAULTS } from "@openbot/contracts/ipc";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { developerInstructions } from "./agent/developer-instructions";
+import {
+  OPENBOT_UI_GUIDE,
+  OPENBOT_UI_LEVELS,
+  openbotUiEnabled,
+  openbotUiGuide,
+  openbotUiInstructions,
+  openbotUiSetting,
+  parseOpenbotUiSetting,
+} from "./openbot-ui-guide";
+
+let dir: string;
+let file: string;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "openbot-ui-"));
+  file = join(dir, "openbot-ui.json");
+  process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE = file;
+});
+
+afterEach(() => {
+  delete process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE;
+  rmSync(dir, { recursive: true, force: true });
+});
+
+function write(text: string, mtimeSeconds: number) {
+  writeFileSync(file, text);
+  utimesSync(file, mtimeSeconds, mtimeSeconds);
+}
+
+const agentFields = {
+  id: "agent-1",
+  name: "Ada",
+  title: "Helper",
+  description: "",
+  provider: "claude",
+  additionalFolders: [],
+  workspacePath: "/root/OpenBot/ada",
+};
+// biome-ignore lint/nursery/noUnsafeTypeAssertion: developerInstructions reads only these fields of the agent.
+const agent = agentFields as unknown as AgentSummary;
+
+function instructions(): string {
+  return developerInstructions(agent, "/root/OpenBot/shared", [], "/root/OpenBot/automation", DEFAULT_AGENT_DEFAULTS);
+}
+
+describe("openbot-ui setting", () => {
+  it("is on + balanced without a setting file, and with an unreadable one", () => {
+    expect(openbotUiSetting()).toEqual({ enabled: true, level: "balanced" });
+    write("{not json", 1000);
+    expect(openbotUiSetting()).toEqual({ enabled: true, level: "balanced" });
+    expect(openbotUiEnabled()).toBe(true);
+  });
+
+  it("reads v1 files as balanced", () => {
+    expect(parseOpenbotUiSetting('{"version":1,"enabled":true}')).toEqual({ enabled: true, level: "balanced" });
+    expect(parseOpenbotUiSetting('{"version":1,"enabled":false}')).toEqual({ enabled: false, level: "balanced" });
+    expect(parseOpenbotUiSetting('{"enabled":false}')).toEqual({ enabled: false, level: "balanced" });
+  });
+
+  it("reads v2 levels, and an unknown level as balanced", () => {
+    for (const level of OPENBOT_UI_LEVELS)
+      expect(parseOpenbotUiSetting(JSON.stringify({ version: 2, enabled: true, level }))).toEqual({
+        enabled: true,
+        level,
+      });
+    expect(parseOpenbotUiSetting('{"version":2,"enabled":true,"level":"max"}').level).toBe("balanced");
+    expect(parseOpenbotUiSetting('{"version":2,"enabled":true,"level":7}').level).toBe("balanced");
+    expect(parseOpenbotUiSetting("null")).toEqual({ enabled: true, level: "balanced" });
+  });
+
+  it("follows the file by mtime: off, then each level", () => {
+    write('{"version":2,"enabled":false,"level":"high"}', 2000);
+    expect(openbotUiInstructions()).toEqual([]);
+    write('{"version":2,"enabled":true,"level":"low"}', 3000);
+    expect(openbotUiInstructions()).toEqual([openbotUiGuide("low")]);
+    write('{"version":2,"enabled":true,"level":"high"}', 4000);
+    expect(openbotUiInstructions()).toEqual([openbotUiGuide("high")]);
+    write('{"version":1,"enabled":true}', 5000);
+    expect(openbotUiInstructions()).toEqual([OPENBOT_UI_GUIDE]);
+  });
+});
+
+describe("openbot-ui guide", () => {
+  it("goes into every agent's developer instructions once while on, and not at all while off", () => {
+    const on = instructions();
+    expect(on.split("<openbot_ui>").length - 1).toBe(1);
+    expect(on).toContain("[ui:action]");
+    expect(on).toContain(openbotUiGuide("balanced"));
+    write('{"version":2,"enabled":true,"level":"low"}', 6000);
+    expect(instructions()).toContain(openbotUiGuide("low"));
+    write('{"version":2,"enabled":false,"level":"balanced"}', 7000);
+    expect(instructions()).not.toContain("<openbot_ui>");
+  });
+
+  it("balanced is the decision rule: concrete triggers", () => {
+    const g = openbotUiGuide("balanced");
+    expect(g).toBe(OPENBOT_UI_GUIDE);
+    expect(g).toMatch(/2\+ options compared on 2\+ attributes: table/u);
+    expect(g).toMatch(/real numeric series.*: chart/u);
+    expect(g).toMatch(/pick one of 2-6 known options: actions chips/u);
+    expect(g).toMatch(/2\+ fields from the user: form/u);
+    expect(g).toMatch(/multi-step work with status: steps or progress/u);
+    expect(g).toMatch(/warning they must not miss: callout/u);
+  });
+
+  it("low waits for an explicit ask or overwhelming structure; high lowers thresholds", () => {
+    expect(openbotUiGuide("low")).toMatch(/only when the user asks for a chart, table, buttons, choices or a form/u);
+    expect(openbotUiGuide("low")).not.toMatch(/- 2\+ options compared/u);
+    expect(openbotUiGuide("high")).toMatch(/any comparison of 2\+ options/u);
+    expect(openbotUiGuide("high")).toMatch(/Never add UI just to decorate/u);
+  });
+
+  it("every level keeps the anti-triggers, the prose line, no invented data, the examples and the catalog", () => {
+    for (const level of OPENBOT_UI_LEVELS) {
+      const g = openbotUiGuide(level);
+      expect(g).toMatch(/Never a block for: chit-chat/u);
+      expect(g).toMatch(/emotional or personal talk/u);
+      expect(g).toMatch(/code \(use a code block\)/u);
+      expect(g).toMatch(/never invent, estimate or pad/u);
+      expect(g).toMatch(/follow-up the UI above already answers/u);
+      expect(g).toMatch(/Always a one-line prose answer/u);
+      expect(g).toMatch(/at most two blocks/u);
+      expect(g).toMatch(/Bad: ask for the data/u);
+      expect(g).toMatch(/callout \{tone/u);
+      // About 550 tokens at most: it rides in every system prompt.
+      expect(g.length).toBeLessThan(2200);
+    }
+  });
+});
