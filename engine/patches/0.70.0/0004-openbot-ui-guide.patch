diff --git a/src/backend/openbot-ui-guide.test.ts b/src/backend/openbot-ui-guide.test.ts
new file mode 100644
index 000000000..62b7e1312
--- /dev/null
+++ b/src/backend/openbot-ui-guide.test.ts
@@ -0,0 +1,76 @@
+import { mkdtempSync, rmSync, utimesSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type AgentSummary, DEFAULT_AGENT_DEFAULTS } from "@openbot/contracts/ipc";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { developerInstructions } from "./agent/developer-instructions";
+import { OPENBOT_UI_GUIDE, openbotUiEnabled, openbotUiInstructions } from "./openbot-ui-guide";
+
+let dir: string;
+let file: string;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "openbot-ui-"));
+  file = join(dir, "openbot-ui.json");
+  process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE = file;
+});
+
+afterEach(() => {
+  delete process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE;
+  rmSync(dir, { recursive: true, force: true });
+});
+
+function write(text: string, mtimeSeconds: number) {
+  writeFileSync(file, text);
+  utimesSync(file, mtimeSeconds, mtimeSeconds);
+}
+
+const agentFields = {
+  id: "agent-1",
+  name: "Ada",
+  title: "Helper",
+  description: "",
+  provider: "claude",
+  additionalFolders: [],
+  workspacePath: "/root/OpenBot/ada",
+};
+// biome-ignore lint/nursery/noUnsafeTypeAssertion: developerInstructions reads only these fields of the agent.
+const agent = agentFields as unknown as AgentSummary;
+
+function instructions(): string {
+  return developerInstructions(agent, "/root/OpenBot/shared", [], "/root/OpenBot/automation", DEFAULT_AGENT_DEFAULTS);
+}
+
+describe("openbot-ui guide", () => {
+  it("is on without a setting file, and with an unreadable one", () => {
+    expect(openbotUiEnabled()).toBe(true);
+    write("{not json", 1000);
+    expect(openbotUiEnabled()).toBe(true);
+  });
+
+  it("is off when the app writes enabled false, and on again after the next write", () => {
+    write('{"enabled":false}', 2000);
+    expect(openbotUiEnabled()).toBe(false);
+    expect(openbotUiInstructions()).toEqual([]);
+    write('{"enabled":true}', 3000);
+    expect(openbotUiEnabled()).toBe(true);
+    expect(openbotUiInstructions()).toEqual([OPENBOT_UI_GUIDE]);
+  });
+
+  it("goes into every agent's developer instructions once while on, and not at all while off", () => {
+    const on = instructions();
+    expect(on.split("<openbot_ui>").length - 1).toBe(1);
+    expect(on).toContain("[ui:action]");
+    write('{"enabled":false}', 4000);
+    expect(instructions()).not.toContain("<openbot_ui>");
+  });
+
+  it("says when to use UI and when not, and stays short", () => {
+    expect(OPENBOT_UI_GUIDE).toMatch(/only when structure clearly beats prose/u);
+    expect(OPENBOT_UI_GUIDE).toMatch(/Not for casual chat/u);
+    expect(OPENBOT_UI_GUIDE).toMatch(/Never invent or pad data/u);
+    expect(OPENBOT_UI_GUIDE).toMatch(/At most two blocks/u);
+    // About 400 tokens at most: it rides in every system prompt.
+    expect(OPENBOT_UI_GUIDE.length).toBeLessThan(1900);
+  });
+});
diff --git a/src/backend/openbot-ui-guide.ts b/src/backend/openbot-ui-guide.ts
new file mode 100644
index 000000000..ab458faa6
--- /dev/null
+++ b/src/backend/openbot-ui-guide.ts
@@ -0,0 +1,55 @@
+// OpenBot Local (fork patch engine-0.70.0-2): every agent learns the `openbot-ui` blocks that the
+// OpenBot Local Android app renders as native UI (docs/openbot-ui.md in the fork), so nobody has to
+// paste the spec into an agent's instructions. The guide is about WHEN to use UI first, then the
+// shape, and is kept short because it rides in every system prompt.
+//
+// The setting "Rich UI in replies" lives in a small JSON file that the app writes inside the rootfs
+// (like dm-context.json). A missing or unreadable file means ON (the default). It is cached by
+// mtime, so a toggle applies to the next instructions the engine builds, without a restart.
+import { readFileSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export const OPENBOT_UI_GUIDE = [
+  "<openbot_ui>",
+  "The user's OpenBot app renders a fenced ```openbot-ui block (JSON: one node, or one node per line) as native UI; other clients show the JSON.",
+  "Use it only when structure clearly beats prose: a comparison or table, numbers, stats or progress, a chart of real data, a choice or confirmation as buttons or chips, several fields to collect (form), step-by-step status. Not for casual chat, short answers, emotional or personal talk, or when one sentence is clearer.",
+  "At most two blocks per reply, each with a one-line prose summary outside it, so the text reads fine alone. Never invent or pad data for a chart, table or stat. Approvals of sends, deletes and payments still go through openbot.ask_ui.",
+  'Nodes ("type"): card {title,subtitle?,body? markdown,image? https,children?: nodes}; stats {items:[{label,value,delta?,tone?:positive|negative|neutral}]}; table {columns:[..],rows:[[..]]}; chart {kind:bar|line|donut,labels:[..],series:[{name,values:[numbers]}]}; list {items:[{icon?,title,subtitle?,trailing?}]}; actions {style?:buttons|chips,items:[{id,label,value?}]}; form {id,fields:[{name,label,kind:text|number|select|toggle,options?,required?}],submit?}; steps {items:[{label,status:done|active|pending|failed}]}; progress {value 0..1,label?}; callout {tone:info|success|warning|error,title?,body}. Max 8 columns, 50 rows, 60 nodes, nesting 3.',
+  'A tap or form submit comes back as a user message "[ui:action] {"id":…,"value":…} — label". Treat it as the user\'s answer to that UI and continue the work; do not show the same UI again unless asked.',
+  "</openbot_ui>",
+].join("\n");
+
+function settingFile(): string {
+  return process.env.OPENBOT_LOCAL_OPENBOT_UI_FILE || join(homedir(), ".openbot-local", "openbot-ui.json");
+}
+
+let cached: { path: string; mtimeMs: number; enabled: boolean } | null = null;
+
+/** Whether "Rich UI in replies" is on. Default ON. */
+export function openbotUiEnabled(): boolean {
+  const path = settingFile();
+  let mtimeMs: number;
+  try {
+    mtimeMs = statSync(path).mtimeMs;
+  } catch {
+    cached = null;
+    return true;
+  }
+  if (cached && cached.path === path && cached.mtimeMs === mtimeMs) return cached.enabled;
+  let enabled = true;
+  try {
+    const parsed = JSON.parse(readFileSync(path, "utf8"));
+    if (typeof parsed === "object" && parsed !== null && "enabled" in parsed && parsed.enabled === false)
+      enabled = false;
+  } catch {
+    enabled = true;
+  }
+  cached = { path, mtimeMs, enabled };
+  return enabled;
+}
+
+/** The guide as an instructions section, or nothing when the setting is off. */
+export function openbotUiInstructions(): string[] {
+  return openbotUiEnabled() ? [OPENBOT_UI_GUIDE] : [];
+}
