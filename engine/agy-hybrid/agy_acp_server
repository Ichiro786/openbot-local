#!/bin/sh
# OpenBot Local hybrid launcher: Google's ACP server frontend on stock CPython 3.14 (no TCMalloc).
# stdout is the ACP JSON-RPC channel: nothing here may print to it (except the --version answer).
D=$(cd "$(dirname "$0")" && pwd); R=$(dirname "$D")
export AGY_HYBRID_SRC="${AGY_HYBRID_SRC:-$R/src}" AGY_HYBRID_ARGV0="$D/agy_acp_server"
# Bridge for engines >= 0.69, which expect the Antigravity CLI 1.5 (`<cli> --version`, then
# `<cli> acp --gemini-dir=<abs> --app-data-dir=antigravity-acp`). A phone that still has only this 1.4.x
# hybrid keeps Gemini working until Set up / Update installs the CLI: answer the version from the server
# itself, and map the flags back to what 1.4.x reads (GEMINI_HOME; its app data folder is antigravity-acp).
if [ "${1:-}" = "--version" ]; then
  v=$(sed -n "s/^__version__[[:space:]]*=[[:space:]]*['\"]\([0-9.]*\)['\"].*/\1/p" \
    "$AGY_HYBRID_SRC/google3/cloud/developer_experience/antigravity_extensions/acp_server/_version.py" 2>/dev/null | head -n 1)
  [ -n "$v" ] || v=$(head -n 1 "$R/.ready" 2>/dev/null)
  [ -n "$v" ] || exit 1
  echo "$v"
  exit 0
fi
if [ "${1:-}" = "acp" ]; then
  shift
  for a do
    shift
    case $a in
      --gemini-dir=*) GEMINI_HOME=${a#--gemini-dir=}; export GEMINI_HOME ;;
      --app-data-dir=*) ;;
      *) set -- "$@" "$a" ;;
    esac
  done
fi
# 1.4.x keeps the Google token in the system keyring unless told otherwise; engines <= 0.61 set this
# themselves, 0.69 no longer does (the 1.5 CLI uses WSL_DISTRO_NAME). acp_token.json is also what 0.69
# copies into the 1.5 CLI's token file, so the sign-in carries over once the CLI is installed.
export AGY_ACP_FORCE_FILE_STORAGE=1
export ANTIGRAVITY_HARNESS_PATH="${ANTIGRAVITY_HARNESS_PATH:-$D/localharness_external}"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# python-build-standalone's OpenSSL looks for /etc/ssl/cert.pem, which Ubuntu does not have.
if [ -z "${SSL_CERT_FILE:-}" ] && [ -r /etc/ssl/certs/ca-certificates.crt ]; then export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt; fi
# The sign-in flow calls $BROWSER/xdg-open with the Google link. open-url records it for the app and
# writes nothing to stdout (the URL is also printed on stderr by the server, where OpenBot reads it).
if [ -z "${BROWSER:-}" ] && [ -x /opt/agy-hybrid/tools/open-url ]; then export BROWSER=/opt/agy-hybrid/tools/open-url; fi
exec "${AGY_HYBRID_PY:-$R/venv/bin/python}" "$D/agy_hybrid.py" "$@"
